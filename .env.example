PORT=8787
HOST=127.0.0.1
DATA_DIR=./data
# MariaDB. Compose publishes the database only on 127.0.0.1:3307;
# Node.js running on the host connects through that local port.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=factura_mx
DB_USER=factura
# Generate separate random values for both passwords before starting Compose.
DB_PASSWORD=replace-with-random-app-password
DB_ROOT_PASSWORD=replace-with-random-root-password
# Set to a 32-byte hex secret in production. Keep it backed up.
# APP_MASTER_KEY=
# APP_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional for local development. Create a Google reCAPTCHA v2 checkbox key for localhost.
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
# Browser headless by default; set false for local debugging.
HEADLESS=true
# GPT-6 Luna is the default for every OpenAI phase. Uncomment to override a phase.
# OPENAI_DISCOVERY_MODEL=gpt-6-luna
# FACTURADOR_VISION_MODEL=gpt-6-luna
# FACTURADOR_BROWSER_MODEL=gpt-6-luna
# Optional SMTP defaults. Each user can configure their own SMTP credentials in the app.
# Per-account API limits for expensive operations. Values are per process.
# API_EXPENSIVE_LIMIT=60
# API_EXPENSIVE_CONCURRENCY=2
# API_ACTION_LIMIT=240
# API_MCP_LIMIT=300
