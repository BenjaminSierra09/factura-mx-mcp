PORT=8787
HOST=127.0.0.1
DATA_DIR=./data
# Set to a 32-byte hex secret in production. Keep it backed up.
# APP_MASTER_KEY=
# APP_ALLOWED_HOSTS=localhost,127.0.0.1
# Browser headless by default; set false for local debugging.
HEADLESS=true
# Optional OpenAI model overrides for each phase (users supply their own API keys).
# OPENAI_DISCOVERY_MODEL=gpt-6-astra
# FACTURADOR_VISION_MODEL=gpt-4.1-mini
# FACTURADOR_BROWSER_MODEL=gpt-4.1-mini
# Optional SMTP defaults. Each user can configure their own SMTP credentials in the app.
# Per-account API limits for expensive operations. Values are per process.
# API_EXPENSIVE_LIMIT=60
# API_EXPENSIVE_CONCURRENCY=2
# API_ACTION_LIMIT=240
# API_MCP_LIMIT=300
