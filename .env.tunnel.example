# A hostname in a domain already managed by Cloudflare. No scheme or trailing slash.
APP_TUNNEL_HOSTNAME=facturas.example.com
# Public deployment defaults to existing accounts only. Enable temporarily if needed.
ALLOW_REGISTRATION=false
# Copy to .env.tunnel, restrict it with chmod 600, and insert the remote tunnel token.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-tunnel-token
