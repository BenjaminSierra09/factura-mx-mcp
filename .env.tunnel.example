# A hostname in a domain already managed by Cloudflare. No scheme or trailing slash.
APP_TUNNEL_HOSTNAME=facturas.example.com
# Public registration uses reCAPTCHA and rate limits. Set false for invited accounts only.
ALLOW_REGISTRATION=true
# MariaDB credentials. Generate two independent random values; retain them with your backups.
DB_PASSWORD=replace-with-random-app-password
DB_ROOT_PASSWORD=replace-with-random-root-password
# Copy to .env.tunnel, restrict it with chmod 600, and insert the remote tunnel token.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-tunnel-token
# Google reCAPTCHA v2 checkbox keys registered for APP_TUNNEL_HOSTNAME.
RECAPTCHA_SITE_KEY=replace-with-site-key
RECAPTCHA_SECRET_KEY=replace-with-secret-key
